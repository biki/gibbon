#!/bin/bash
# Reject commit messages that are not Conventional Commits.
# Enable once per clone:  git config core.hooksPath .githooks
# Skip in an emergency:   git commit --no-verify
root="$(git rev-parse --show-toplevel)"
# The subject is the first line that is neither empty nor a comment.
subject="$(grep -v '^#' "$1" | sed '/^[[:space:]]*$/d' | head -n 1)"
exec "$root/scripts/check-commit-subject.sh" "$subject"
